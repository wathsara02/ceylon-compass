# Backend API base URL.
# Leave unset in production/Vercel — the app falls back to the relative
# "/api" path, which vercel.json rewrites to the backend serverless function.
# Only needed locally, where the frontend and backend run on different ports.
VITE_API_URL=http://localhost:5001/api

# Firebase web app config (Project Settings > General > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
