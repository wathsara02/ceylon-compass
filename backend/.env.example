# Firebase Admin SDK (Project Settings > Service Accounts > Generate new private key)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Alternative to the three vars above: paste the whole service account JSON as one line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

PORT=5001

# Gmail SMTP for outgoing notification emails
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Optional: used by scripts/seedAdmin.js
SEED_ADMIN_EMAIL=admin@ceyloncompass.dummy
SEED_ADMIN_PASSWORD=password123
SEED_ADMIN_USERNAME=admin_dummy
